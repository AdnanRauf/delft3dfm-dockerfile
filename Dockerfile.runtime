# syntax=docker/dockerfile:1
# =============================================================================
# Delft3D FM runtime extension — layered on the OFFICIAL delft3d image
# (built from doc/delft3d.Dockerfile at tag DIMRset_2026.02).
#
# The official final stage is bare AlmaLinux 8 + /delft3d. The install step
# (src/cmake/install_linux_libs/copy_libs.sh) bundles every shared-library
# dependency of every executable into /delft3d/lib and patches RPATHs to
# $ORIGIN:$ORIGIN/../lib — so the binaries are self-contained — but the
# Intel MPI *launcher* (mpirun / mpiexec.hydra / hydra_* helpers) is not a
# shared-library dependency and therefore is NOT in the image. Multi-rank
# runs are impossible without it. This layer adds:
#
#   1. The Intel MPI runtime (launcher + libfabric), version-matched to the
#      MPI the binaries were built against (2021.13.1 for oneAPI 2024).
#   2. run_parallel.sh — the hybrid MPI+OpenMP launcher helper. Recreated
#      here with a build-time non-empty gate, permanently fixing the
#      0-byte-file defect from the earlier bug report.
#   3. Single-node container env defaults (shm fabric, tcp libfabric
#      provider, OpenMP pinning).
#   4. Hard build-time smoke tests, including proof that
#      ESMF_RegridWeightGen is the mpiuni (MPI-free) build — the structural
#      fix for the PMPI_Alltoallw segfault/hang in FM+D-Waves coupled runs.
#   5. PROJ data-file fix. copy_libs.sh bundles libproj.so but NOT proj.db
#      (a data file, not a shared library), and the compiled-in search path
#      points at a Conan cache dir that does not exist in the final stage.
#      Result: "proj_create: Cannot find proj.db" at runtime and any model
#      needing a real CRS transformation (geographic/wgs84 grids, coupled
#      components exchanging across differing CRSes) fails or silently
#      mis-projects. This layer locates proj.db in the base image, installs
#      it at a stable path, exports PROJ_DATA/PROJ_LIB, and gates on it.
# =============================================================================

ARG BASE_IMAGE=localhost/delft3d:DIMRset_2026.02-oneapi-2024-ifx-Release

# The third-party-libs image is where PROJ was actually built and installed
# (third-party-libs.Dockerfile, "FROM base AS proj": PROJ 9.7.1 configured with
# -DCMAKE_INSTALL_PREFIX=/usr/local, so its data lands in /usr/local/share/proj).
# We need it as a stage purely to lift proj.db out — see the PROJ section below.
# Must match the tag the build driver produced: oneapi-<ver>-<fc>-<BuildType>.
ARG TPL_IMAGE=localhost/delft3d-third-party-libs:oneapi-2024-ifx-Release
FROM ${TPL_IMAGE} AS tpl

FROM ${BASE_IMAGE}

ARG INTEL_MPI_RUNTIME_VERSION=2021.13.1

# Which suite the base image was built with. Used by the smoke tests below to
# decide whether the classic Delft3D 4 engines (d_hydro / flow2d3d) must be
# present: they exist only for CONFIGURATION=all or d3d4-suite.
ARG CONFIGURATION=all

# ---- Intel MPI runtime + basic ops tools ------------------------------------
# Runtime-only MPI package (not -devel): provides mpirun, mpiexec.hydra, the
# hydra_* bootstrap/proxy helpers, libmpi and the bundled libfabric providers.
# hostname/procps are needed by the launcher and for diagnostics (top, ps).
#
# tcl: mormerge is driven by /delft3d/bin/mormerge.tcl, whose shebang is
# literally "#! /usr/bin/tclsh" and which re-invokes /usr/bin/tclsh by absolute
# path for the per-condition worker scripts it generates. The official install
# step ships the .tcl (install(PROGRAMS ... mormerge.tcl DESTINATION bin)) but
# not an interpreter, so run_mormerge.sh — documented in CHEATSHEET.md and used
# by both Delft3D 4 AND FM morphodynamics (see
# test/deltares_testbench/configs/dimr/dimr_dflowfm_mormerge_lnx64.xml) — could
# not run at all. mormerge.tcl needs no Tcl extensions (no `package require`),
# so the base tcl package suffices.
RUN <<"EOF"
set -euxo pipefail
cat > /etc/yum.repos.d/oneAPI.repo <<'REPO'
[oneAPI]
name=Intel oneAPI repository
baseurl=https://yum.repos.intel.com/oneapi
enabled=1
gpgcheck=1
repo_gpgcheck=1
gpgkey=https://yum.repos.intel.com/intel-gpg-keys/GPG-PUB-KEY-INTEL-SW-PRODUCTS.PUB
REPO
dnf install --assumeyes \
    intel-oneapi-mpi-${INTEL_MPI_RUNTIME_VERSION} \
    hostname procps-ng which binutils tcl
dnf clean all
# Resolve the versioned MPI dir to a stable path we can bake into ENV.
MPI_DIR="$(ls -d /opt/intel/oneapi/mpi/2021.* | sort -V | tail -1)"
test -x "${MPI_DIR}/bin/mpirun"
ln -sfn "${MPI_DIR}" /opt/intel/oneapi/mpi/stable
EOF

# ---- Environment -------------------------------------------------------------
# /delft3d binaries resolve their own libs via RPATH; LD_LIBRARY_PATH here is
# for the MPI launcher stack only. Both historical Intel MPI lib layouts are
# listed (lib/release vs lib, libfabric/lib vs opt/mpi/libfabric/lib) —
# nonexistent entries are harmless and the smoke test below validates the
# launcher actually works.
ENV I_MPI_ROOT=/opt/intel/oneapi/mpi/stable
ENV D3D_HOME=/delft3d \
    PATH=/delft3d/bin:${I_MPI_ROOT}/bin:${PATH} \
    LD_LIBRARY_PATH=${I_MPI_ROOT}/lib:${I_MPI_ROOT}/lib/release:${I_MPI_ROOT}/libfabric/lib:${I_MPI_ROOT}/opt/mpi/libfabric/lib \
    FI_PROVIDER_PATH=${I_MPI_ROOT}/libfabric/lib/prov:${I_MPI_ROOT}/opt/mpi/libfabric/lib/prov

# Single-node / single-container defaults for hybrid MPI + OpenMP:
#   I_MPI_FABRICS=shm    shared memory only — no interconnect probing hangs
#   FI_PROVIDER=tcp      safe libfabric provider inside a container
#   I_MPI_PIN_DOMAIN=omp pin domains sized to OMP_NUM_THREADS for hybrid runs
# OMP_NUM_THREADS is deliberately unset: pure-OpenMP runs use all cores;
# run_parallel.sh sets it explicitly for hybrid runs.
ENV I_MPI_FABRICS=shm \
    FI_PROVIDER=tcp \
    I_MPI_PIN_DOMAIN=omp \
    OMP_PLACES=cores \
    OMP_PROC_BIND=close

# ---- PROJ data ---------------------------------------------------------------
# Root cause (verified against the DIMRset_2026.02 tree):
#   * third-party-libs.Dockerfile builds PROJ 9.7.1 with
#     -DCMAKE_INSTALL_PREFIX=/usr/local, so proj.db installs to
#     /usr/local/share/proj/proj.db in the BUILD image.
#   * src/cmake/install_all/copy_libs.sh populates /delft3d/lib purely by
#     running ldd over the executables and copying the resulting .so paths.
#     It has no notion of data files, so proj.db is never staged into /delft3d.
#   * doc/delft3d.Dockerfile's final stage is only:
#         FROM ${BASE_IMAGE_URL}
#         COPY --from=build /delft3d/ /delft3d/
#     so anything outside /delft3d — including /usr/local/share/proj — is lost.
# Net effect: libproj.so ships, its database does not, and PROJ emits
#   proj_create: Cannot find proj.db
#   proj_create: unrecognized format / unknown name
# at runtime. Harmless for Cartesian/projected grids that never request a CRS
# transformation, but any geographic (lat/lon, wgs84) model — or coupling that
# exchanges data across differing CRSes — fails or silently mis-projects.
#
# Fix: copy the whole PROJ resource directory straight out of the
# third-party-libs stage (deterministic path, no guessing) and point PROJ at it.
# Copying the directory rather than just proj.db also brings proj.ini and any
# datum grid-shift files along, so grid-based transformations work too.
COPY --from=tpl /usr/local/share/proj/ /delft3d/share/proj/

# PROJ_DATA is the modern variable; PROJ_LIB is the legacy one that older PROJ
# and some GDAL paths still honour. Both point at the directory copied above.
ENV PROJ_DATA=/delft3d/share/proj \
    PROJ_LIB=/delft3d/share/proj

# ---- run_parallel.sh -----------------------------------------------------------
RUN cat > /usr/local/bin/run_parallel.sh <<'EOS' && chmod +x /usr/local/bin/run_parallel.sh
#!/usr/bin/env bash
# Delft3D FM hybrid MPI + OpenMP launcher (single-node / single-container).
#
# Usage:
#   run_parallel.sh [-n RANKS] [-t THREADS] <model.mdu>
#   run_parallel.sh [-n RANKS] [-t THREADS] -d <dimr_config.xml>
#
#   -n RANKS    MPI domains/ranks              (default: all available cores)
#   -t THREADS  OpenMP threads per MPI rank    (default: 1 = pure MPI)
#   -d FILE     run via DIMR with this config  (coupled models, e.g. FM+Waves)
#
# Examples:
#   run_parallel.sh model.mdu                 # MPI on all cores
#   run_parallel.sh -n 8 model.mdu            # 8 domains
#   run_parallel.sh -n 4 -t 2 model.mdu       # hybrid: 4 ranks x 2 threads
#   run_parallel.sh -n 6 -d dimr_config.xml   # coupled run, 6 ranks
set -euo pipefail

NRANKS=""
NTHREADS="1"
DIMR_CFG=""

usage() { grep '^#' "$0" | sed -n '2,16p' >&2; exit 2; }

while getopts ":n:t:d:h" opt; do
  case "$opt" in
    n) NRANKS="$OPTARG" ;;
    t) NTHREADS="$OPTARG" ;;
    d) DIMR_CFG="$OPTARG" ;;
    h|*) usage ;;
  esac
done
shift $((OPTIND - 1))
MDU="${1:-}"

ulimit -s unlimited 2>/dev/null || true

NCORES="$(nproc)"
if [ -z "$NRANKS" ]; then
  NRANKS=$(( NCORES / NTHREADS ))
  [ "$NRANKS" -lt 1 ] && NRANKS=1
fi

export OMP_NUM_THREADS="$NTHREADS"
export I_MPI_FABRICS="${I_MPI_FABRICS:-shm}"
export FI_PROVIDER="${FI_PROVIDER:-tcp}"
export I_MPI_PIN_DOMAIN="${I_MPI_PIN_DOMAIN:-omp}"

echo "==> cores=$NCORES  ranks=$NRANKS  threads/rank=$NTHREADS  (fabric=$I_MPI_FABRICS)"

if [ -n "$DIMR_CFG" ]; then
  [ -f "$DIMR_CFG" ] || { echo "DIMR config not found: $DIMR_CFG" >&2; exit 1; }
  echo "==> mpirun -np $NRANKS dimr $DIMR_CFG"
  exec mpirun -np "$NRANKS" dimr "$DIMR_CFG"
fi

[ -n "$MDU" ] || usage
[ -f "$MDU" ] || { echo "MDU not found: $MDU" >&2; exit 1; }

if [ "$NRANKS" -gt 1 ]; then
  echo "==> partitioning into $NRANKS domains"
  dflowfm --nodisplay --partition:ndomains="$NRANKS":icgsolver=6 "$MDU"
  echo "==> mpirun -np $NRANKS dflowfm --nodisplay --autostartstop $MDU"
  exec mpirun -np "$NRANKS" dflowfm --nodisplay --autostartstop "$MDU"
else
  echo "==> single rank, OpenMP threads=$NTHREADS"
  exec dflowfm --nodisplay --autostartstop "$MDU"
fi
EOS

# ---- Build-time smoke tests ----------------------------------------------------
# Fail the image build (not the first user run) if anything critical is broken.
RUN <<"EOF"
set -euxo pipefail

echo "--- [gate 1] run_parallel.sh exists, is non-empty, and parses ---"
test -s /usr/local/bin/run_parallel.sh          # the old image shipped a 0-byte file
bash -n /usr/local/bin/run_parallel.sh
head -2 /usr/local/bin/run_parallel.sh

echo "--- [gate 2] MPI launcher present and functional under shm fabric ---"
which mpirun mpiexec.hydra
mpirun --version | head -2
I_MPI_FABRICS=shm mpirun -np 2 hostname

echo "--- [gate 3] core binaries present ---"
test -x /delft3d/bin/dflowfm
test -x /delft3d/bin/dimr
test -x /delft3d/bin/run_dimr.sh
test -x /delft3d/bin/run_dflowfm.sh

echo "--- [gate 4] dflowfm: no unresolved shared libraries ---"
ldd /delft3d/bin/dflowfm | grep -E 'libmpi|libiomp5|libpetsc' || true
if ldd /delft3d/bin/dflowfm | grep -q 'not found'; then
    echo "FATAL: unresolved shared libraries in dflowfm:"
    ldd /delft3d/bin/dflowfm | grep 'not found'
    exit 1
fi

echo "--- [gate 5] dflowfm built with MPI and OpenMP ---"
# Guards the historical upstream regression where dflowfm-cli_exe applies
# ${openmp_flag} only under WIN32. As of 2.31.13 dflowfm_kernel applied it
# unconditionally; keep this gate so the regression can never silently
# return. If it trips: patch dflowfm-cli_exe/CMakeLists.txt to apply
# ${openmp_flag} on UNIX (compile + link) and rebuild.
/delft3d/bin/dflowfm --nodisplay --version | tee /tmp/v.txt
grep -qiE 'MPI[[:space:]]*:[[:space:]]*yes'    /tmp/v.txt || { echo "FATAL: dflowfm built WITHOUT MPI";    exit 1; }
grep -qiE 'OpenMP[[:space:]]*:[[:space:]]*yes' /tmp/v.txt || { echo "FATAL: dflowfm built WITHOUT OpenMP"; exit 1; }

echo "--- [gate 6] ESMF regrid tool: present, resolvable, and not DIRECTLY MPI-linked ---"
# wave_exe.cmake installs both the wrapper script and the ESMF binary into
# /delft3d/bin. third-party-libs.Dockerfile builds ESMF with
#     export ESMF_COMM=mpiuni # we do not need mpi
# so ESMF's internal collectives are serial stubs. An ESMF that genuinely used
# real MPI would reintroduce the PMPI_Alltoallw crash/hang in FM+D-Waves runs.
#
# IMPORTANT: do NOT test this with `ldd | grep libmpi`. ldd prints the entire
# transitive dependency tree, and HDF5 in this stack is deliberately built
# parallel (./configure CC=mpiicx ... --enable-parallel), so libmpi/libmpifort
# legitimately appear via netcdf -> hdf5 even for a pure mpiuni ESMF. That naive
# check produces a false FATAL. Inspect the binary's DIRECT DT_NEEDED entries
# instead — those are what ESMF_RegridWeightGen itself was linked against.
test -s /delft3d/bin/ESMF_RegridWeightGen_in_Delft3D-WAVE.sh
test -x /delft3d/bin/ESMF_RegridWeightGen
if ldd /delft3d/bin/ESMF_RegridWeightGen | grep -q 'not found'; then
    echo "FATAL: unresolved shared libraries in ESMF_RegridWeightGen:"
    ldd /delft3d/bin/ESMF_RegridWeightGen | grep 'not found'
    exit 1
fi

ESMF_NEEDED="$(readelf -d /delft3d/bin/ESMF_RegridWeightGen \
                 | awk '/\(NEEDED\)/ {gsub(/[][]/,"",$NF); print $NF}')"
echo "ESMF_RegridWeightGen direct DT_NEEDED:"
echo "${ESMF_NEEDED}" | sed 's/^/    /'
if echo "${ESMF_NEEDED}" | grep -q '^libmpi'; then
    echo "FATAL: ESMF_RegridWeightGen links libmpi DIRECTLY — expected the mpiuni"
    echo "       (serial) build. Check ESMF_COMM in third-party-libs.Dockerfile;"
    echo "       it must be 'mpiuni'. A real-MPI ESMF reintroduces the"
    echo "       PMPI_Alltoallw segfault/hang in coupled FM+D-Waves runs."
    exit 1
fi
echo "OK: no direct libmpi dependency."
# Transitive libmpi (via parallel HDF5) is expected and harmless — show it so
# the distinction is on the record rather than being silently tolerated.
if ldd /delft3d/bin/ESMF_RegridWeightGen | grep -q 'libmpi'; then
    echo "NOTE: libmpi present transitively (parallel HDF5 -> netcdf), as expected:"
    ldd /delft3d/bin/ESMF_RegridWeightGen | grep 'libmpi' | sed 's/^/    /'
fi
/delft3d/bin/ESMF_RegridWeightGen --version 2>&1 | head -3 || true

echo "--- [gate 7] PROJ data file present and non-trivial ---"
# Guards the "proj_create: Cannot find proj.db" runtime message: libproj.so was
# bundled by copy_libs.sh but its database was not (see the PROJ section above).
# NOTE: third-party-libs.Dockerfile builds PROJ with -DBUILD_APPS=OFF, so the
# projinfo/cs2cs CLIs do NOT exist in this image — we cannot smoke-test a real
# reprojection here. Verify the artefact instead: present, non-empty, a valid
# SQLite database, and containing the expected CRS tables (a truncated or
# zero-byte copy would otherwise sail through a bare -s check).
test -s "${PROJ_DATA}/proj.db"
head -c 15 "${PROJ_DATA}/proj.db" | grep -q 'SQLite format 3' || {
    echo "FATAL: ${PROJ_DATA}/proj.db is not a valid SQLite database"; exit 1; }
ls -la "${PROJ_DATA}/" | head -20
echo "proj.db size: $(stat -c %s "${PROJ_DATA}/proj.db") bytes"
# A real proj.db is tens of MB; anything tiny means a broken/partial copy.
[ "$(stat -c %s "${PROJ_DATA}/proj.db")" -gt 1000000 ] || {
    echo "FATAL: ${PROJ_DATA}/proj.db is implausibly small — partial copy?"; exit 1; }

echo "--- [gate 8] classic Delft3D 4 engines (CONFIGURATION=${CONFIGURATION}) ---"
# The Delft3D 4 side (d_hydro + libflow2d3d) is only built for CONFIGURATION=all
# or d3d4-suite. Per src/cmake/configurations/testbench/all_configuration.cmake,
# 'all' adds flow2d3d, d_hydro, rtc, tools_gpl, mormerge and the culvert/traform
# plugins on top of the FM suite. Classic models are launched through DIMR with a
# flow2d3d component, or directly via run_dflow2d3d.sh (see examples/delft3d4/).
case "${CONFIGURATION}" in
  all|d3d4-suite|flow2d3d)
    test -x /delft3d/bin/d_hydro || {
        echo "FATAL: CONFIGURATION=${CONFIGURATION} but /delft3d/bin/d_hydro is missing"; exit 1; }
    test -s /delft3d/bin/run_dflow2d3d.sh || {
        echo "FATAL: run_dflow2d3d.sh missing — classic launcher not installed"; exit 1; }
    # The engine itself is a shared library loaded by d_hydro at runtime.
    ls /delft3d/lib/libflow2d3d*.so >/dev/null 2>&1 || {
        echo "FATAL: libflow2d3d*.so not found in /delft3d/lib"; exit 1; }
    if ldd /delft3d/bin/d_hydro | grep -q 'not found'; then
        echo "FATAL: unresolved shared libraries in d_hydro:"
        ldd /delft3d/bin/d_hydro | grep 'not found'
        exit 1
    fi
    echo "Classic Delft3D 4 present:"
    ls -la /delft3d/bin/d_hydro /delft3d/bin/run_dflow2d3d.sh
    ls /delft3d/lib/libflow2d3d*.so
    ;;
  *)
    echo "NOTE: CONFIGURATION=${CONFIGURATION} is FM-only — skipping Delft3D 4 checks."
    ;;
esac

echo "--- [gate 9] Tcl at the hardcoded path mormerge.tcl requires ---"
# mormerge.tcl's shebang is literally "#! /usr/bin/tclsh", and it re-invokes
# /usr/bin/tclsh by ABSOLUTE path when it writes the per-condition worker
# scripts. A tclsh elsewhere on PATH therefore does NOT satisfy it — test the
# exact path, not `command -v tclsh`.
test -x /usr/bin/tclsh || {
    echo "FATAL: /usr/bin/tclsh missing — mormerge.tcl cannot execute."
    echo "       Add 'tcl' to the dnf install list above."
    exit 1; }
echo 'puts "tcl [info patchlevel] ok"' | /usr/bin/tclsh

# The Tcl driver and its shell launcher are installed by
# src/tools_gpl/mormerge/packages/mormerge/CMakeLists.txt, which is only part of
# the build for configurations that include the classic tools.
case "${CONFIGURATION}" in
  all|d3d4-suite)
    test -x /delft3d/bin/mormerge.tcl || {
        echo "FATAL: /delft3d/bin/mormerge.tcl missing"; exit 1; }
    test -s /delft3d/bin/run_mormerge.sh || {
        echo "FATAL: /delft3d/bin/run_mormerge.sh missing"; exit 1; }
    echo "mormerge driver present; shebang: $(head -1 /delft3d/bin/mormerge.tcl)"
    ;;
  *)
    echo "NOTE: CONFIGURATION=${CONFIGURATION} — skipping mormerge asset checks."
    ;;
esac

echo "=== ALL GATES PASSED: MPI launcher + OpenMP + serial ESMF regrid + PROJ data + Tcl/mormerge + suite contents OK ==="
EOF

WORKDIR /work
CMD ["/bin/bash", "-l"]
